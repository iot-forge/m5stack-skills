{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "results.schema.json",
 "title": "A verification run's results file: verification/runs/<YYYY-MM-DD>.json (VERIFICATION.md section 8)",
 "type": "object",
 "required": [
  "run",
  "results"
 ],
 "additionalProperties": false,
 "properties": {
  "run": {
   "type": "object",
   "required": [
    "date",
    "operator",
    "host_os",
    "plugin_commit",
    "unit",
    "toolchains"
   ],
   "additionalProperties": false,
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "operator": {
     "type": "string"
    },
    "host_os": {
     "type": "string"
    },
    "plugin_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{7,40}$"
    },
    "unit": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "revision",
        "sku_sticker"
       ],
       "additionalProperties": false,
       "properties": {
        "revision": {
         "type": "string",
         "pattern": "^[a-z0-9-]+@[a-z0-9.-]+$"
        },
        "sku_sticker": {
         "type": "string"
        }
       }
      }
     ]
    },
    "toolchains": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check",
     "result"
    ],
    "additionalProperties": false,
    "properties": {
     "check": {
      "type": "string",
      "pattern": "^(data|query|build|trigger|handoff|host|flash|device|fact|open-question)\\.\\S+$"
     },
     "result": {
      "enum": [
       "pass",
       "fail",
       "blocked",
       "not-run",
       "observed"
      ]
     },
     "observed": {
      "type": "string"
     },
     "output": {
      "type": "string"
     },
     "blocked_by": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
