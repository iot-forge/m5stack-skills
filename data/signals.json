  {
   "id": "atecc-probe",
   "kind": "probe",
   "observe": "Flash a sketch that wakes the ATECC608B, then reads 4 bytes from I2C 0x35 and compares them with the wake reply.",
   "probe": {
    "bus": "i2c_internal",
    "address": "0x35",
    "register": null,
    "width": null,
    "wake": {
     "sda_low_us_min": 60,
     "alt_zero_address_byte_at_hz": 100000,
     "then_wait_us_min": 1500
    },
    "read_bytes": 4,
    "expected": {
     "present": [
      "0x04",
      "0x11",
      "0x33",
      "0x43"
     ],
     "absent": "no ACK at 0x35 after the wake"
    },
    "note": "Wake by holding SDA low for at least 60 us, or by sending 0x00 as the address byte at 100 kHz (nothing ACKs it), then wait at least 1500 us (SelfTest does not run at wake on the TNGTLS part). A plain read with no word address returns count 0x04, status 0x11 (after wake, before the first command) and a CRC-16. The chip ignores a wake while already awake, and 0x11 is only returned before its first command, so run the probe before anything else talks to it. The CRC bytes 0x33 0x43 are computed with the data sheet's rule (polynomial 0x8005, initial value 0), not quoted from it."
   },
   "outcomes": {
    "present": [
     "core2-for-aws@v1.0",
     "core2-for-aws@v1.3"
    ],
    "absent": [
     "core2@v1.0",
     "core2@2023.02",
     "core2@v1.1",
     "core2@v1.3"
    ]
   },
   "reliability": "medium",
   "caveats": "Needs flashing. The ATECC608B sleeps; a plain address scan may miss it.",
   "src": [
    "m5-core2-for-aws",
    "m5-core2-for-aws-v1.3",
    "ds-atecc608b-tngtls"
   ],
   "confidence": "medium",
   "last_verified": "2026-09-26"
  },
