  {
   "id": "pmic-probe",
   "kind": "probe",
   "observe": "Flash a sketch that reads register 0x03 of the chip at I2C 0x34 on the internal bus.",
   "probe": {
    "bus": "i2c_internal",
    "address": "0x34",
    "register": "0x03",
    "width": 8,
    "expected": {
     "AXP192": "0x03",
     "AXP2101": "0x4A"
    },
    "datasheet_gap": "The expected values come from M5Unified. The AXP192 datasheet does not document register 0x03, and the one AXP2101 datasheet that does (rev 0.1, 2019) gives 0x47 or 0x57, not 0x4A. A hardware run on a Core2 v1.3 settles the AXP192 value; the AXP2101 value needs a Core2 v1.1 or a CoreS3-family unit."
   },
   "outcomes": {
    "AXP192": [
     "core2@v1.0",
     "core2@2023.02",
     "core2@v1.3",
     "core2-for-aws@v1.0",
     "core2-for-aws@v1.3",
     "tough@v1.0"
    ],
    "AXP2101": [
     "core2@v1.1",
     "cores3@v1.0",
     "cores3-se@v1.0",
     "cores3-lite@v1.0"
    ]
   },
   "reliability": "high",
   "caveats": "Needs flashing, and is inferred from a chip ID. The two PMICs share address 0x34, so an address scan alone cannot tell them apart.",
   "src": [
    "m5unified",
    "m5-core2",
    "m5-core2-v1.1",
    "m5-core2-v1.3"
   ],
   "confidence": "high",
   "last_verified": "2026-09-26"
  },
  {
   "id": "imu-probe",
   "kind": "probe",
   "observe": "Flash a sketch that reads the IMU identity register: 0x75 at I2C 0x68 (MPU family), or 0x00 at 0x68/0x69 (BMI270).",
   "probe": {
    "bus": "i2c_internal",
    "reads": [
     {
      "address": "0x68",
      "register": "0x75",
      "width": 8,
      "expected": {
       "MPU6886": "0x19",
       "MPU9250": "0x71",
       "MPU6050": "0x68"
      }
     },
     {
      "address": [
       "0x68",
       "0x69"
      ],
      "register": "0x00",
      "width": 8,
      "expected": {
       "BMI270": "0x24"
      }
     }
    ]
   },
   "outcomes": {
    "MPU6886": [
     "core2@v1.0",
     "core2@2023.02",
     "core2@v1.1",
     "core2-for-aws@v1.0",
     "fire@2019.08",
     "fire@2020.04",
     "fire@v2.7",
     "m5go@2019.06",
     "m5go@v2.6",
     "m5go@v2.7",
     "gray@2019.06"
    ],
    "BMI270": [
     "core2@v1.3",
     "core2-for-aws@v1.3",
     "cores3@v1.0",
     "cores3-lite@v1.0"
    ],
    "MPU9250": [
     "gray@2017.12",
     "fire@2018.06",
     "m5go@2018.04"
    ],
    "MPU6050": [
     "gray@2017.09"
    ],
    "none": [
     "basic@v1.4",
     "basic@v2.5",
     "basic@v2.6",
     "basic@v2.7",
     "tough@v1.0",
     "cores3-se@v1.0"
    ]
   },
   "reliability": "high",
   "caveats": "Needs flashing, and is inferred from a chip ID. Fire 2019.7 (SH200Q) is not covered. The MPU-9250 register map (RM-MPU-9250A-00 rev 1.4) contradicts itself on register 0x75: its header gives a reset value of 0x68, its text a default of 0x71. The data expects 0x71, as M5Unified does; a reading of 0x68 at 0x75 is ambiguous between an MPU-9250 and an MPU-6050.",
   "src": [
    "m5unified",
    "ds-mpu6886",
    "ds-mpu9250",
    "ds-mpu6050",
    "ds-bmi270",
    "m5-core2",
    "m5-core2-v1.3",
    "m5-cores3",
    "m5-gray",
    "m5-fire",
    "m5-m5go-v2.7"
   ],
   "confidence": "high",
   "last_verified": "2026-09-26"
