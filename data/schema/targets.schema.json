{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "targets.schema.json",
 "title": "Build targets: data/targets/<toolchain>.json",
 "type": "object",
 "required": [
  "schema_version",
  "toolchain",
  "targets"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "toolchain": {
   "enum": [
    "arduino-esp32",
    "arduino-m5stack",
    "platformio",
    "uiflow2",
    "esp-bsp"
   ]
  },
  "targets": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "$ref": "#/$defs/provenance"
     },
     {
      "type": "object",
      "required": [
       "id",
       "covers",
       "per_revision"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "covers": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/revision_id"
        }
       },
       "per_revision": {
        "type": "object",
        "additionalProperties": {
         "type": "string"
        }
       },
       "note": {
        "type": "string"
       }
      }
     }
    ]
   }
  }
 },
 "$defs": {
  "provenance": {
   "type": "object",
   "required": [
    "src",
    "confidence",
    "last_verified"
   ],
   "properties": {
    "src": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low"
     ]
    },
    "last_verified": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  },
  "fact": {
   "$ref": "#/$defs/provenance"
  },
  "gpio": {
   "type": "string",
   "pattern": "^G\\d{1,2}$"
  },
  "revision_id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+@[a-z0-9.-]+$"
  },
  "support": {
   "type": "object",
   "required": [
    "status",
    "reason",
    "src",
    "last_verified"
   ],
   "additionalProperties": false,
   "properties": {
    "status": {
     "enum": [
      "supported",
      "roadmap",
      "out-of-scope"
     ]
    },
    "reason": {
     "type": "string",
     "minLength": 10
    },
    "src": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "last_verified": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  }
 }
}
