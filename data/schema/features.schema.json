{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "features.schema.json",
 "title": "Feature list: data/features.json",
 "type": "object",
 "required": [
  "schema_version",
  "features"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "features": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "text": {
      "type": "string"
     }
    }
   }
  }
 }
}
